@page "/messages/create"
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using Social.Data
@using Social.Domain
@inject IDbContextFactory<Social.Data.SocialContext> DbFactory
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.SignalR.IHubContext<Social.Hubs.ChatHub> ChatHubContext

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Message</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Message" OnValidSubmit="AddMessage" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="content" class="form-label">Content:</label> 
                <InputText id="content" @bind-Value="Message.Content" class="form-control" /> 
                <ValidationMessage For="() => Message.Content" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="senderid" class="form-label">SenderId:</label> 
                <InputText id="senderid" @bind-Value="Message.SenderId" class="form-control" /> 
                <ValidationMessage For="() => Message.SenderId" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="groupid" class="form-label">GroupId:</label> 
                <InputNumber id="groupid" @bind-Value="Message.GroupId" class="form-control" /> 
                <ValidationMessage For="() => Message.GroupId" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="datecreated" class="form-label">DateCreated:</label> 
                <InputDate id="datecreated" @bind-Value="Message.DateCreated" class="form-control" /> 
                <ValidationMessage For="() => Message.DateCreated" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="dateupdated" class="form-label">DateUpdated:</label> 
                <InputDate id="dateupdated" @bind-Value="Message.DateUpdated" class="form-control" /> 
                <ValidationMessage For="() => Message.DateUpdated" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="createdby" class="form-label">CreatedBy:</label> 
                <InputText id="createdby" @bind-Value="Message.CreatedBy" class="form-control" /> 
                <ValidationMessage For="() => Message.CreatedBy" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="updatedby" class="form-label">UpdatedBy:</label> 
                <InputText id="updatedby" @bind-Value="Message.UpdatedBy" class="form-control" /> 
                <ValidationMessage For="() => Message.UpdatedBy" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/messages">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Message Message { get; set; } = new();
    private HubConnection? HubConnection;
    private List<string> Messages = new List<string>();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.

    private async Task AddMessage()
    {
        using var context = DbFactory.CreateDbContext();
        context.Message.Add(Message);
        await context.SaveChangesAsync();

        // Notify clients of a new message
        await ChatHubContext.Clients.All.SendAsync("ReceiveMessage", Message.SenderId, Message.Content);

        NavigationManager.NavigateTo("/messages");
    }

    protected override async Task OnInitializedAsync()
    {
        HubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.BaseUri + "chathub")
            .Build();

        HubConnection.On<string, string>("ReceiveMessage", (user, message) =>
        {
            Messages.Add($"{user}: {message}");
            StateHasChanged(); // Forces UI to update
        });

        await HubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (HubConnection is not null)
        {
            await HubConnection.DisposeAsync();
        }
    }

}
